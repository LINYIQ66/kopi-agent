# KOPI Agent Environment Configuration
# Copy this file to .env and fill in your API keys
# For the managed KOPI setup (recommended), most settings are pre-configured.
#
# KOPI Proxy is the recommended way to use KOPI Agent — it handles model routing,
# load balancing, fallback, billing, and enterprise features out of the box.
# Default: https://kopi.readinghero.xyz/kp/v1
#
# Quick start: Run `kopi setup` or configure ~/.kopi/config.yaml

# =============================================================================
# LLM PROVIDER (KOPI Proxy — Recommended)
# =============================================================================
# KOPI Proxy provides unified access to 20+ models (MiMo, DeepSeek, Claude, Gemini, etc.)
# with automatic fallback, semantic caching, and PII masking built in.
# Get your key at: https://kopi.readinghero.xyz
#
# KOPI_PROXY_BASE_URL=https://kopi.readinghero.xyz/kp/v1
# KOPI_PROXY_API_KEY=kp-your_api_key_here

# =============================================================================
# LLM PROVIDER (OpenRouter)
# =============================================================================
# OpenRouter provides access to many models through one API
# Get your key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# =============================================================================
# LLM PROVIDER (Xiaomi MiMo — Direct)
# =============================================================================
# Xiaomi MiMo models (mimo-v2-pro, mimo-v2-omni, mimo-v2-flash, mimo-v2.5-pro).
# Get your key at: https://platform.xiaomimimo.com
# XIAOMI_API_KEY=
# XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1

# =============================================================================
# LLM PROVIDER (DeepSeek)
# =============================================================================
# DeepSeek models (deepseek-chat, deepseek-reasoner).
# Get your key at: https://platform.deepseek.com
# DEEPSEEK_API_KEY=

# =============================================================================
# LLM PROVIDER (Google AI Studio / Gemini)
# =============================================================================
# Native Gemini API via Google's OpenAI-compatible endpoint.
# Get your key at: https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# =============================================================================
# TOOL API KEYS
# =============================================================================

# Exa API Key — AI-native web search
# Get at: https://exa.ai
# EXA_API_KEY=

# Firecrawl API Key — Web search, extract, and crawl
# Get at: https://firecrawl.dev/
# FIRECRAWL_API_KEY=

# FAL.ai API Key — Image generation
# Get at: https://fal.ai/
# FAL_KEY=

# Browserbase API Key — Cloud browser execution
# Get at: https://browserbase.com/
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
BROWSERBASE_PROXIES=true
BROWSERBASE_ADVANCED_STEALTH=false

# Weaviate/OpenAI-compatible embedding service (for semantic cache, RAG)
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_BASE_URL=

# =============================================================================
# KOPI AGENT GATEWAY CONFIGURATION
# =============================================================================

# Gateway listen port (default: 8001)
# GATEWAY_PORT=8001

# Gateway control password (for admin endpoints)
# KOPI_CONTROL_PASSWORD=

# =============================================================================
# PLATFORM INTEGRATIONS
# =============================================================================

# Telegram Bot Token — From @BotFather (https://t.me/BotFather)
# TELEGRAM_BOT_TOKEN=

# WhatsApp (built-in Baileys bridge — run `kopi whatsapp` to pair)
# WHATSAPP_ENABLED=false

# WeChat (iLink bridge)
# WECHAT_ENABLED=false
# WECHAT_BOT_TOKEN=
# WECHAT_ILINK_BOT_ID=

# =============================================================================
# TERMINAL TOOL CONFIGURATION
# =============================================================================
# Terminal backend: local, docker, ssh, or modal
# TERMINAL_ENV=local
# TERMINAL_CWD=.
# TERMINAL_TIMEOUT=60
# TERMINAL_LIFETIME_SECONDS=300

# =============================================================================
# DEBUG OPTIONS
# =============================================================================
# WEB_TOOLS_DEBUG=false
# VISION_TOOLS_DEBUG=false

# =============================================================================
# SUDO SUPPORT (optional — for password-protected sudo on local backend)
# =============================================================================
# SUDO_PASSWORD=your_password_here
